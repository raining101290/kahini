# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real credentials.

# --- Contact form (src/app/api/contact/route.ts) -----------------------
# SMTP credentials for the mailbox that sends contact-form notifications.
# kahinistudios.com's email is hosted on Google Workspace, not cPanel mail
# — so this authenticates against Gmail's SMTP, not the hosting server.
# SMTP_PASS must be a 16-character Google "App Password"
# (myaccount.google.com/apppasswords, requires 2-Step Verification on that
# mailbox), NOT the account's normal login password — Google rejects plain
# password SMTP auth from third-party apps.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# "true" for implicit TLS (port 465). "false" (this project's default) uses
# STARTTLS on port 587 — Gmail supports both; 587 is the more common setup.
SMTP_SECURE=false
SMTP_USER=hello@kahinistudios.com
SMTP_PASS=

# Optional overrides:
# From header shown to recipients. Defaults to "Kahini Studios" <SMTP_USER>.
# SMTP_FROM="Kahini Studios" <hello@kahinistudios.com>
# Destination inbox for contact form submissions. Defaults to
# hello@kahinistudios.com if unset.
# CONTACT_TO_EMAIL=hello@kahinistudios.com

# --- SEO / metadata (src/content/site.ts) -------------------------------
# Public production URL, used for metadataBase, canonical links, sitemap,
# and JSON-LD. Falls back to a placeholder if unset.
# NEXT_PUBLIC_SITE_URL=https://kahinistudios.com
