# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored — never commit real credentials.

# --- Contact form (src/app/api/contact/route.ts) -----------------------
# SMTP credentials for the mailbox that sends contact-form notifications.
# Works with any SMTP provider tied to the kahinistudios.com domain
# (Google Workspace, Zoho Mail, cPanel/Postfix, etc).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# "true" for implicit TLS (usually port 465). Leave unset/"false" for
# STARTTLS on port 587, which is the more common setup.
SMTP_SECURE=false
SMTP_USER=hello@kahinistudios.com
SMTP_PASS=

# Optional overrides:
# From header shown to recipients. Defaults to "Kahini Studios" <SMTP_USER>.
# SMTP_FROM="Kahini Studios" <hello@kahinistudios.com>
# Destination inbox for contact form submissions. Defaults to
# hello@kahinistudios.com if unset.
# CONTACT_TO_EMAIL=hello@kahinistudios.com

# --- SEO / metadata (src/content/site.ts) -------------------------------
# Public production URL, used for metadataBase, canonical links, sitemap,
# and JSON-LD. Falls back to a placeholder if unset.
# NEXT_PUBLIC_SITE_URL=https://kahini.com
